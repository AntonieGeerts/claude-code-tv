# Copy to hooks/tv_status.env (never commit it).
TV_STATUS_URL=https://<your-project>.vercel.app/api/event
TV_STATUS_TOKEN=<your INGEST_TOKEN>
TV_STATUS_HOST=my-pc                 # label shown on the TV
TV_STATUS_SHARE_PROMPTS=0            # 1 = show the first 70 chars of each prompt on the TV
# WSL only: the Windows-side Claude Code login, so its sessions map to the right cswap account
# TV_STATUS_WINDOWS_CLAUDE_JSON=/mnt/c/Users/<you>/.claude.json
