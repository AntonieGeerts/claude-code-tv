# Copy to .env.local in the repo root (never commit it).
STATUS_URL=https://<your-project>.vercel.app/api/status
INGEST_TOKEN=<random, e.g. openssl rand -hex 24>   # hooks -> API
READ_TOKEN=<random, e.g. openssl rand -hex 24>     # TV -> API (baked into the APK)
# LAUNCHER_KEYSTORE_PASS is generated by launcher/build.sh on first build. Keep it and launcher/attic-launcher.jks safe:
# every future update of the app must be signed with the same key.
# ADB=adb   # on WSL you can use the Windows one: /mnt/c/Users/<you>/AppData/Local/Android/Sdk/platform-tools/adb.exe
